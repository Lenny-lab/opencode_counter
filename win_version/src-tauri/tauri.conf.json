{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCode Stats",
  "version": "1.0.0",
  "identifier": "dev.opencode.stats.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "popover",
        "title": "OpenCode Stats",
        "width": 360,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false,
        "center": true
      },
      {
        "label": "dashboard",
        "title": "OpenCode 用量看板",
        "width": 1180,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 660,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "OpenCode token usage monitor",
    "longDescription": "Reads your local OpenCode database and reports token usage, cost, cache effectiveness and per-project activity."
  }
}
